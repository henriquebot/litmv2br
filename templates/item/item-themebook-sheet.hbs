<section class="tab {{tabs.form.id}} {{tabs.form.cssClass}} scrollable" id="form" data-tab="{{tabs.form.id}}"
    data-group="{{tabs.form.group}}">
    <div class="box-shadowed-container">
        <div class="flexrow">
            <label><strong>{{localize "MIST_ENGINE.LABELS.Type"}}</strong></label>
            <select name="system.type">
                <option value="">-</option>
                <option value="litm-origin" {{#if (eq system.type "litm-origin" )}}selected{{/if}}>LitM - {{localize "MIST_ENGINE.MIGHT.Origin"}}
                </option>
                <option value="litm-adventure" {{#if (eq system.type "litm-adventure" )}}selected{{/if}}>LitM - {{localize "MIST_ENGINE.MIGHT.Adventure"}}</option>
                <option value="litm-variable" {{#if (eq system.type "litm-variable" )}}selected{{/if}}>LitM - {{localize "MIST_ENGINE.MIGHT.Variable"}}
                </option>
                <option value="litm-greatness" {{#if (eq system.type "litm-greatness" )}}selected{{/if}}>LitM - {{localize "MIST_ENGINE.MIGHT.Greatness"}}</option>
            </select>
        </div>
    </div>
    <div class="box-shadowed-container">
        <div class="flexrow">
            <label><strong>{{localize "MIST_ENGINE.LABELS.Color"}}</strong></label>
            <select name="system.color">
                <option value="">-</option>
                <option value="litm-origin" {{#if (eq system.color "litm-origin" )}}selected{{/if}}>{{localize "MIST_ENGINE.LABELS.Green"}}</option>
                <option value="litm-adventure" {{#if (eq system.color "litm-adventure" )}}selected{{/if}}>{{localize "MIST_ENGINE.LABELS.Brown"}}</option>
                <option value="litm-variable" {{#if (eq system.color "litm-variable" )}}selected{{/if}}>{{localize "MIST_ENGINE.LABELS.Black"}}</option>
                <option value="litm-greatness" {{#if (eq system.color "litm-greatness" )}}selected{{/if}}>{{localize "MIST_ENGINE.LABELS.Purple"}}
                </option>
            </select>
        </div>
    </div>
    <div class="box-shadowed-container">
        <div class="item-powertag-line flexrow">
            <h4 class="with-line">{{localize "MIST_ENGINE.LABELS.Questions"}}</h4>
        </div>
        <div class="themebook-section-header clickable" data-action="addEmptyPowertag" data-item-id="{{themebook._id}}">
            <i class="fas fa-plus add-line-icon " title="{{localize "MIST_ENGINE.LABELS.AddPowertag"}}"></i> {{localize
            "MIST_ENGINE.LABELS.AddPowertag"}}
        </div>
        <div data-array-list="system.powertags">
        {{#each system.powertags as |powertag index|}}
        {{> "systems/mist-engine-fvtt/templates/item/parts/themebook-powertag-line.hbs" index=index powertag=powertag}}
        {{/each}}
        </div>

        <div class="themebook-section-header clickable" data-action="addEmptyWeaknessTag"
            data-item-id="{{themebook._id}}">
            <i class="fas fa-plus add-line-icon " title="{{localize "MIST_ENGINE.LABELS.AddWeaknesstag"}}"></i>
            {{localize "MIST_ENGINE.LABELS.AddWeaknesstag"}}
        </div>
        <div data-array-list="system.weaknesstags">
        {{#each system.weaknesstags as |weakness index|}}
        {{> "systems/mist-engine-fvtt/templates/item/parts/themebook-weakness-line.hbs" index=index weakness=weakness}}
        {{/each}}
        </div>
    </div>
    {{#unless system.options.isStoryTheme}}
    <div class="box-shadowed-container">
        <h4 class="with-line">{{localize "MIST_ENGINE.LABELS.SpecialImprovements"}}</h4>
        {{#each system.specialImprovements as |imp index|}}
        {{> "systems/mist-engine-fvtt/templates/item/parts/themebook-special-improvement-line.hbs" index=index imp=imp showDelete=true}}
        {{/each}}
    </div>
    {{/unless}}
</section>